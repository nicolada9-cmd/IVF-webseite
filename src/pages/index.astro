---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, treatments } from '../data/site.js';
import { u } from '../lib/url.js';

const faqs = [
  { q: 'Was ist ein Kurzgespräch?', a: 'Ein kostenloses, unverbindliches Kurzgespräch, in dem wir Ihre Situation kennenlernen und die nächsten Schritte besprechen – die niederschwellige Möglichkeit, uns kennenzulernen, bevor Sie ein Erstgespräch vereinbaren.' },
  { q: 'Wie unterscheidet sich das Erstgespräch vom Kurzgespräch?', a: 'Im ausführlichen Erstgespräch mit einer Fachärztin oder einem Facharzt erfassen wir Ihre Vorgeschichte umfassend, besprechen Diagnostik und mögliche Behandlungswege – es ist der Start in Ihre individuelle Behandlung.' },
  { q: 'Übernimmt die Krankenkasse die Kosten?', a: 'Ein Teil der Kinderwunschbehandlungen wird in Österreich über den IVF-Fonds gefördert, sofern die Voraussetzungen erfüllt sind. Die Details klären wir individuell mit Ihnen.' },
  { q: 'Wo befindet sich die Klinik?', a: `Wir sind in Bregenz, ${site.address}. Termine und Befunde verwalten bestehende Patient:innen bequem über das Patientenportal.` },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Next Fertility IVF Zech Bregenz',
  url: 'https://www.ivf.at',
  telephone: site.phone,
  email: site.email,
  medicalSpecialty: 'Reproductive',
  address: { '@type': 'PostalAddress', streetAddress: 'Römerstraße 2', postalCode: '6900', addressLocality: 'Bregenz', addressCountry: 'AT' },
  availableService: treatments.map((t) => ({ '@type': 'MedicalProcedure', name: t.title })),
};
---
<Base title="Next Fertility Bregenz – Kinderwunsch, IVF & Eizellspende" jsonld={jsonld}>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <span class="eyebrow">Kinderwunschmedizin in Bregenz</span>
        <h1>Kompetenz, die <em>Vertrauen</em> schafft — auf Ihrem Weg zum Kind.</h1>
        <p class="lead">Vom ersten Gedanken bis zur Behandlung begleiten wir Sie persönlich, fachlich fundiert und auf Augenhöhe. Beginnen Sie unverbindlich mit einem kostenlosen Kurzgespräch.</p>
        <div class="hero__actions">
          <a href={site.bookingErstgespraech} class="btn btn--primary btn--lg" target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
          <a href={site.bookingKurzgespraech} class="btn btn--secondary btn--lg" target="_blank" rel="noopener">Kostenloses Kurzgespräch</a>
        </div>
        <ul class="hero__trust">
          <li><Icon name="check" /> Erfahrenes Fachärzt:innen-Team</li>
          <li><Icon name="check" /> Eigenes Labor &amp; moderne Diagnostik</li>
          <li><Icon name="check" /> Persönliche Begleitung</li>
        </ul>
      </div>
      <div class="hero__media">
        <img src={u('/img/hero.jpg')} alt="Schwangere Frau hält ihren Babybauch" width="1376" height="768" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- BEHANDLUNGEN -->
  <section class="section" id="behandlungen">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Behandlungen</span>
        <h2>Alles aus <em>einer Hand</em> – klar und vollständig.</h2>
        <p class="lead">Was bisher auf viele Seiten verteilt war, finden Sie jetzt gebündelt: von IVF und Eizellspende bis zu Andrologie und Hysteroskopie.</p>
      </div>
      <div class="grid grid-4">
        {treatments.map((t) => (
          <a href={u(`/behandlungen/${t.slug}/`)} class="card treatment">
            <span class="treatment__tag">{t.tag}{t.neu && <em class="treatment__neu">Neu</em>}</span>
            <h3>{t.title}</h3>
            <p>{t.teaser}</p>
            <span class="treatment__more">Mehr erfahren <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FUNNEL / DEIN WEG -->
  <section class="section section--soft" id="ablauf">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Dein Weg zu uns</span>
        <h2>In drei Schritten – ohne Druck, in <em>Ihrem Tempo</em>.</h2>
      </div>
      <div class="grid grid-3 steps">
        <div class="step">
          <span class="step__num">01</span>
          <h3>Kurzgespräch</h3>
          <p>Kostenlos &amp; unverbindlich. Wir lernen Ihre Situation kennen und beantworten erste Fragen.</p>
          <a href={site.bookingKurzgespraech} class="btn btn--text" target="_blank" rel="noopener">Kurzgespräch buchen <Icon name="arrow" /></a>
        </div>
        <div class="step step--highlight">
          <span class="step__num">02</span>
          <h3>Erstgespräch</h3>
          <p>Ausführliches Gespräch mit einer Fachärztin oder einem Facharzt – Diagnostik und Behandlungsweg.</p>
          <a href={site.bookingErstgespraech} class="btn btn--text" target="_blank" rel="noopener">Erstgespräch vereinbaren <Icon name="arrow" /></a>
        </div>
        <div class="step">
          <span class="step__num">03</span>
          <h3>Behandlung</h3>
          <p>Ihr individueller Behandlungsplan – persönlich begleitet, mit Befunden &amp; Terminen im Portal.</p>
          <a href={u('/ablauf/')} class="btn btn--text">Ablauf im Detail <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- AKADEMIE -->
  <section class="section">
    <div class="container split">
      <div class="split__panel split__panel--blush" aria-hidden="true">
        <span class="split__label accent">Fruchtbarkeit &amp; Du</span>
      </div>
      <div class="split__text">
        <span class="eyebrow">Gesundheitsakademie</span>
        <h2>Fruchtbarkeit &amp; <em>Du</em></h2>
        <p class="lead">Wissen schafft Sicherheit. In unseren regelmäßigen Webinaren teilen unsere Expert:innen verständlich, was bei Kinderwunsch wirklich zählt – vorwärtsgewandt und auf dem aktuellen Stand der Medizin.</p>
        <div class="split__actions">
          <a href={site.webinarZoom} class="btn btn--primary" target="_blank" rel="noopener">Zum nächsten Webinar anmelden</a>
          <a href={u('/akademie/')} class="btn btn--text">Alle Themen &amp; Aufzeichnungen <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ZUWEISER -->
  <section class="section section--soft">
    <div class="container split split--reverse">
      <div class="split__text">
        <span class="eyebrow">Für Zuweiser:innen</span>
        <h2>Partnerschaft auf <em>Augenhöhe</em>.</h2>
        <p class="lead">Sie betreuen Patient:innen mit Kinderwunsch? Wir bieten klare Überweisungswege, schnelle Rückmeldung und fachlichen Austausch – Ihre Patient:innen bleiben in besten Händen.</p>
        <a href={u('/zuweiser/')} class="btn btn--secondary">Informationen für Zuweiser:innen</a>
      </div>
      <div class="split__panel split__panel--slate" aria-hidden="true">
        <span class="split__label">Zuweiser:innen</span>
      </div>
    </div>
  </section>

  <!-- WISSEN -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Wissen</span>
        <h2>Fundiertes Wissen, <em>klar aufbereitet</em>.</h2>
        <p class="lead">Medizinische Informationen zum schnellen Nachlesen – plus unser Magazin mit Geschichten und Hintergründen rund um den Kinderwunsch.</p>
      </div>
      <div class="grid grid-3">
        <a href={u('/behandlungen/genetik-pid/')} class="card know"><h3>Genetik verständlich</h3><p>Was PID und genetische Diagnostik für Ihre Behandlung bedeuten.</p><span class="treatment__more">Mehr erfahren <Icon name="arrow" /></span></a>
        <a href={u('/behandlungen/eizellspende/')} class="card know"><h3>Eizellspende von A–Z</h3><p>Ablauf, Voraussetzungen und rechtlicher Rahmen – kompakt erklärt.</p><span class="treatment__more">Mehr erfahren <Icon name="arrow" /></span></a>
        <a href={u('/wissen/')} class="card know"><h3>Kinderwunsch-Magazin</h3><p>Erfahrungsberichte, Tipps und Hintergründe in Langform.</p><span class="treatment__more">Zum Magazin <Icon name="arrow" /></span></a>
      </div>
    </div>
  </section>

  <!-- PATIENTENPORTAL BAND -->
  <section class="section">
    <div class="container">
      <div class="portal">
        <div>
          <span class="eyebrow">Bestehende Patient:innen</span>
          <h2>Schon in Behandlung <em>bei uns</em>?</h2>
          <p class="lead">Über das Patientenportal rufen Sie Befunde ab, vereinbaren Termine und kontaktieren den medizinischen Dienst – sicher und jederzeit.</p>
        </div>
        <a href={site.patientenportal} class="btn btn--primary btn--lg portal__btn" target="_blank" rel="noopener"><Icon name="lock" /> Zum Patientenportal</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--soft">
    <div class="container faq-wrap">
      <div class="section-head section-head--center">
        <span class="eyebrow">Häufige Fragen</span>
        <h2>Gut zu <em>wissen</em></h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  /* HERO */
  .hero { background: linear-gradient(180deg, var(--blush) 0%, var(--bg) 78%); padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .hero__inner { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero h1 { margin-bottom: 1.1rem; }
  .hero__actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin: 1.8rem 0 1.8rem; }
  .hero__trust { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.55rem; color: var(--ink-soft); font-size: 0.96rem; }
  .hero__trust li { display: flex; align-items: center; gap: 0.55rem; }
  .hero__trust .icon { color: var(--rose); }
  .hero__media img { width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  @media (max-width: 900px) { .hero__inner { grid-template-columns: 1fr; } .hero__media { order: -1; } }

  /* Behandlungs-Karten – feine, ruhige Labels statt bunter Badges */
  .treatment { display: flex; flex-direction: column; }
  .treatment__tag { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.9rem; display: flex; align-items: center; gap: 0.6rem; }
  .treatment__neu { font-style: normal; color: var(--rose); border: 1px solid var(--rose-soft); padding: 0.05rem 0.45rem; border-radius: var(--radius-pill); font-size: 0.62rem; letter-spacing: 0.1em; }
  .treatment h3 { margin-bottom: 0.5rem; }
  .treatment p { font-size: 0.93rem; color: var(--muted); line-height: 1.6; flex-grow: 1; margin-bottom: 1rem; }
  .treatment__more { color: var(--rose); font-weight: 600; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 0.35rem; }
  .card:hover .treatment__more .icon { transform: translateX(3px); }
  .treatment__more .icon { transition: transform 0.25s ease; }

  /* Steps – feine, outlinierte Nummern */
  .step { padding: 0.5rem 0.5rem 0.5rem 0; }
  .step__num { font-family: var(--font-accent); font-style: italic; font-size: 1.7rem; color: var(--rose-soft); display: block; margin-bottom: 0.6rem; }
  .step--highlight .step__num { color: var(--rose); }
  .step h3 { margin-bottom: 0.5rem; }
  .step p { color: var(--muted); font-size: 0.96rem; margin-bottom: 0.8rem; }
  .steps { gap: 2.5rem; }

  /* Split-Sektionen – ruhige, tonale Panels statt bunter Verläufe */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .split--reverse .split__panel { order: -1; }
  .split__actions { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap; margin-top: 0.5rem; }
  .split__panel { min-height: 340px; border-radius: var(--radius-lg); display: grid; place-items: center; border: 1px solid var(--line); }
  .split__panel--blush { background: linear-gradient(150deg, var(--blush-2), var(--blush)); }
  .split__panel--slate { background: linear-gradient(150deg, var(--slate-soft), #f6f8f9); }
  .split__label { font-family: var(--font-accent); font-style: italic; font-size: 1.9rem; color: var(--ink-soft); opacity: 0.55; }
  .split__panel--blush .split__label { color: var(--rose); opacity: 0.8; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } .split--reverse .split__panel { order: 0; } }

  /* Portal – elegantes Blush-Band statt knalligem Blau */
  .portal { background: var(--blush); border-radius: var(--radius-lg); padding: clamp(2.2rem, 4vw, 3.4rem); display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .portal h2 { margin-bottom: 0.6rem; }
  .portal .lead { margin: 0; max-width: 560px; }
  .portal__btn { flex-shrink: 0; }

  /* FAQ */
  .faq-wrap { max-width: 800px; }
  .faq__item { border-bottom: 1px solid var(--line-strong); padding: 1.15rem 0.2rem; }
  .faq__item summary { font-weight: 500; font-size: 1.08rem; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; color: var(--ink); }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; color: var(--rose); font-size: 1.4rem; font-weight: 300; line-height: 1; }
  .faq__item[open] summary::after { content: '–'; }
  .faq__item p { margin: 0.9rem 0 0.2rem; color: var(--ink-soft); }
</style>
