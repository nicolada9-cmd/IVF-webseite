---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, treatments } from '../data/site.js';
import { u } from '../lib/url.js';

const faqs = [
  { q: 'Was ist ein Kurzgespräch?', a: 'Ein kostenloses, unverbindliches Kurzgespräch, in dem wir Ihre Situation kennenlernen und die nächsten Schritte besprechen – die niederschwellige Möglichkeit, uns kennenzulernen, bevor Sie ein Erstgespräch vereinbaren.' },
  { q: 'Wie unterscheidet sich das Erstgespräch vom Kurzgespräch?', a: 'Im ausführlichen Erstgespräch mit einer Fachärztin oder einem Facharzt erfassen wir Ihre Vorgeschichte umfassend, besprechen Diagnostik und mögliche Behandlungswege – es ist der Start in Ihre individuelle Behandlung.' },
  { q: 'Übernimmt die Krankenkasse die Kosten?', a: 'Ein Teil der Kinderwunschbehandlungen wird in Österreich über den IVF-Fonds gefördert, sofern die Voraussetzungen erfüllt sind. Die Details klären wir individuell mit Ihnen.' },
  { q: 'Wo befindet sich die Klinik?', a: `Wir sind in Bregenz, ${site.address}. Termine und Befunde verwalten bestehende Patient:innen bequem über das Patientenportal.` },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: 'Next Fertility IVF Zech Bregenz',
  url: 'https://www.ivf.at',
  telephone: site.phone,
  email: site.email,
  medicalSpecialty: 'Reproductive',
  address: { '@type': 'PostalAddress', streetAddress: 'Römerstraße 2', postalCode: '6900', addressLocality: 'Bregenz', addressCountry: 'AT' },
  availableService: treatments.map((t) => ({ '@type': 'MedicalProcedure', name: t.title })),
};
---
<Base title="Next Fertility Bregenz – Kinderwunsch, IVF & Eizellspende" jsonld={jsonld} heroOverlay={true}>

  <!-- VOLLBILD-HERO -->
  <section class="hero">
    <img class="hero__img" src={u('/img/hero.jpg')} alt="Schwangere Frau hält ihren Babybauch" fetchpriority="high" />
    <div class="hero__scrim"></div>
    <div class="container hero__content">
      <span class="hero__eyebrow">Kinderwunschmedizin in Bregenz</span>
      <h1 class="hero__title">Kompetenz, die <em>Vertrauen</em> schafft — auf Ihrem Weg zum Kind.</h1>
      <p class="hero__sub">Vom ersten Gedanken bis zur Behandlung begleiten wir Sie persönlich, fachlich fundiert und auf Augenhöhe.</p>
      <div class="hero__actions">
        <a href={site.bookingErstgespraech} class="btn btn--primary btn--lg" target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
        <a href={site.bookingKurzgespraech} class="btn btn--outline-light btn--lg" target="_blank" rel="noopener">Kostenloses Kurzgespräch</a>
      </div>
    </div>
    <a href="#statement" class="hero__scroll" aria-label="Weiter scrollen"><span></span></a>
  </section>

  <!-- STATEMENT -->
  <section class="section statement" id="statement">
    <div class="container container--narrow">
      <span class="eyebrow">Willkommen bei Next Fertility</span>
      <p class="statement__text">Die Kinderwunschklinik in Bregenz, die Ihre Situation ernst nimmt und mit Ihnen den Weg zu <em>Ihrem Kind</em> geht.</p>
    </div>
  </section>

  <!-- BEHANDLUNGEN -->
  <section class="section section--cream" id="behandlungen">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Behandlungen</span>
        <h2>Alles aus einer Hand</h2>
        <p class="lead">Was bisher auf viele Seiten verteilt war, finden Sie jetzt gebündelt: von IVF und Eizellspende bis zu Andrologie und Hysteroskopie.</p>
      </div>
      <div class="grid grid-4">
        {treatments.map((t) => (
          <a href={u(`/behandlungen/${t.slug}/`)} class="card treatment">
            <span class="treatment__tag">{t.tag}{t.neu && <em class="treatment__neu">Neu</em>}</span>
            <h3>{t.title}</h3>
            <p>{t.teaser}</p>
            <span class="treatment__more">Mehr erfahren <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FUNNEL -->
  <section class="section" id="ablauf">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Dein Weg zu uns</span>
        <h2>In drei Schritten – in Ihrem Tempo</h2>
      </div>
      <div class="grid grid-3 steps">
        <div class="step">
          <span class="step__num">01</span>
          <h3>Kurzgespräch</h3>
          <p>Kostenlos &amp; unverbindlich. Wir lernen Ihre Situation kennen und beantworten erste Fragen.</p>
          <a href={site.bookingKurzgespraech} class="btn btn--text" target="_blank" rel="noopener">Kurzgespräch buchen <Icon name="arrow" /></a>
        </div>
        <div class="step step--highlight">
          <span class="step__num">02</span>
          <h3>Erstgespräch</h3>
          <p>Ausführliches Gespräch mit einer Fachärztin oder einem Facharzt – Diagnostik und Behandlungsweg.</p>
          <a href={site.bookingErstgespraech} class="btn btn--text" target="_blank" rel="noopener">Erstgespräch vereinbaren <Icon name="arrow" /></a>
        </div>
        <div class="step">
          <span class="step__num">03</span>
          <h3>Behandlung</h3>
          <p>Ihr individueller Behandlungsplan – persönlich begleitet, mit Befunden &amp; Terminen im Portal.</p>
          <a href={u('/ablauf/')} class="btn btn--text">Ablauf im Detail <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- AKADEMIE -->
  <section class="section section--soft">
    <div class="container split">
      <div class="split__panel split__panel--blush" aria-hidden="true"><span class="split__label">Fruchtbarkeit &amp; Du</span></div>
      <div class="split__text">
        <span class="eyebrow">Gesundheitsakademie</span>
        <h2>Fruchtbarkeit &amp; <em>Du</em></h2>
        <p class="lead">Wissen schafft Sicherheit. In unseren regelmäßigen Webinaren teilen unsere Expert:innen verständlich, was bei Kinderwunsch wirklich zählt – vorwärtsgewandt und auf dem aktuellen Stand der Medizin.</p>
        <div class="split__actions">
          <a href={site.webinarZoom} class="btn btn--primary" target="_blank" rel="noopener">Zum nächsten Webinar</a>
          <a href={u('/akademie/')} class="btn btn--text">Alle Themen &amp; Aufzeichnungen <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ZUWEISER -->
  <section class="section">
    <div class="container split split--reverse">
      <div class="split__text">
        <span class="eyebrow">Für Zuweiser:innen</span>
        <h2>Partnerschaft auf <em>Augenhöhe</em></h2>
        <p class="lead">Sie betreuen Patient:innen mit Kinderwunsch? Wir bieten klare Überweisungswege, schnelle Rückmeldung und fachlichen Austausch – Ihre Patient:innen bleiben in besten Händen.</p>
        <a href={u('/zuweiser/')} class="btn btn--secondary">Informationen für Zuweiser:innen</a>
      </div>
      <div class="split__panel split__panel--cream" aria-hidden="true"><span class="split__label">Zuweiser:innen</span></div>
    </div>
  </section>

  <!-- WISSEN -->
  <section class="section section--cream">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Wissen</span>
        <h2>Fundiertes Wissen, klar aufbereitet</h2>
        <p class="lead">Medizinische Informationen zum schnellen Nachlesen – plus unser Magazin mit Geschichten und Hintergründen rund um den Kinderwunsch.</p>
      </div>
      <div class="grid grid-3">
        <a href={u('/behandlungen/genetik-pid/')} class="card know"><h3>Genetik verständlich</h3><p>Was PID und genetische Diagnostik für Ihre Behandlung bedeuten.</p><span class="treatment__more">Mehr erfahren <Icon name="arrow" /></span></a>
        <a href={u('/behandlungen/eizellspende/')} class="card know"><h3>Eizellspende von A–Z</h3><p>Ablauf, Voraussetzungen und rechtlicher Rahmen – kompakt erklärt.</p><span class="treatment__more">Mehr erfahren <Icon name="arrow" /></span></a>
        <a href={u('/wissen/')} class="card know"><h3>Kinderwunsch-Magazin</h3><p>Erfahrungsberichte, Tipps und Hintergründe in Langform.</p><span class="treatment__more">Zum Magazin <Icon name="arrow" /></span></a>
      </div>
    </div>
  </section>

  <!-- PATIENTENPORTAL (dunkles Band für Abwechslung) -->
  <section class="section section--ink">
    <div class="container portal">
      <div>
        <span class="eyebrow">Bestehende Patient:innen</span>
        <h2>Schon in Behandlung bei uns?</h2>
        <p class="portal__lead">Über das Patientenportal rufen Sie Befunde ab, vereinbaren Termine und kontaktieren den medizinischen Dienst – sicher und jederzeit.</p>
      </div>
      <a href={site.patientenportal} class="btn btn--light btn--lg portal__btn" target="_blank" rel="noopener"><Icon name="lock" /> Zum Patientenportal</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--soft">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        <span class="eyebrow">Häufige Fragen</span>
        <h2>Gut zu wissen</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  /* VOLLBILD-HERO */
  .hero { position: relative; min-height: 100vh; display: flex; align-items: center; overflow: hidden; }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% center; }
  .hero__scrim { position: absolute; inset: 0; background:
      linear-gradient(100deg, rgba(24,16,20,0.82) 0%, rgba(24,16,20,0.62) 42%, rgba(24,16,20,0.34) 64%, rgba(24,16,20,0.06) 88%),
      linear-gradient(0deg, rgba(24,16,20,0.30), rgba(24,16,20,0) 35%); }
  .hero__content { position: relative; z-index: 2; max-width: 760px; padding-top: var(--header-h); color: #fff; }
  .hero__eyebrow { display: inline-block; font-size: 0.74rem; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--rose-soft); margin-bottom: 1.4rem; }
  .hero__title { color: #fff; font-size: clamp(2.4rem, 5.2vw, 4.2rem); font-weight: 300; line-height: 1.12; letter-spacing: -0.015em; margin-bottom: 1.3rem; max-width: 15ch; }
  .hero__title em { font-family: var(--font-accent); font-style: normal; color: var(--rose-soft); font-weight: 400; }
  .hero__sub { font-size: clamp(1.05rem, 1.6vw, 1.3rem); color: rgba(255,255,255,0.9); max-width: 540px; margin-bottom: 2.2rem; }
  .hero__actions { display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .hero__scroll { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); z-index: 2; width: 26px; height: 42px; border: 1.5px solid rgba(255,255,255,0.6); border-radius: 14px; display: grid; place-items: start center; padding-top: 7px; }
  .hero__scroll span { width: 3px; height: 8px; background: #fff; border-radius: 2px; animation: scrolldot 1.6s ease-in-out infinite; }
  @keyframes scrolldot { 0%,100% { opacity: 0.3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(6px); } }
  @media (max-width: 600px) { .hero__scrim { background: linear-gradient(90deg, rgba(28,20,24,0.78), rgba(28,20,24,0.45)); } }

  /* STATEMENT */
  .statement { padding-block: clamp(3.5rem, 6vw, 5.5rem); }
  .statement__text { font-size: clamp(1.7rem, 3vw, 2.6rem); font-weight: 300; line-height: 1.36; letter-spacing: -0.01em; color: var(--ink); margin: 0; max-width: 20ch; }
  .statement__text em { font-style: normal; font-family: var(--font-accent); color: var(--rose); }

  /* Behandlungs-Karten */
  .treatment { display: flex; flex-direction: column; }
  .treatment__tag { font-size: 0.66rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.6rem; }
  .treatment__neu { font-style: normal; color: var(--rose); border: 1px solid var(--rose-soft); padding: 0.05rem 0.45rem; border-radius: var(--radius-pill); font-size: 0.6rem; letter-spacing: 0.12em; }
  .treatment h3 { margin-bottom: 0.55rem; font-size: 1.2rem; }
  .treatment p { font-size: 0.93rem; color: var(--muted); line-height: 1.6; flex-grow: 1; margin-bottom: 1.1rem; }
  .treatment__more { color: var(--rose); font-weight: 500; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 0.4rem; }
  .card:hover .treatment__more .icon { transform: translateX(3px); }
  .treatment__more .icon { transition: transform 0.25s ease; }

  /* Steps */
  .steps { gap: 2.6rem; }
  .step { padding-right: 1rem; }
  .step__num { font-size: 1.5rem; font-weight: 500; color: var(--rose-soft); display: block; margin-bottom: 0.7rem; letter-spacing: 0.05em; }
  .step--highlight .step__num { color: var(--rose); }
  .step h3 { margin-bottom: 0.5rem; }
  .step p { color: var(--muted); font-size: 0.96rem; margin-bottom: 0.9rem; }

  /* Splits */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .split--reverse .split__panel { order: -1; }
  .split__actions { display: flex; gap: 1.4rem; align-items: center; flex-wrap: wrap; margin-top: 0.3rem; }
  .split__panel { min-height: 360px; border-radius: var(--radius-lg); display: grid; place-items: center; }
  .split__panel--blush { background: linear-gradient(150deg, #f3e4e9, var(--blush)); }
  .split__panel--cream { background: linear-gradient(150deg, var(--cream-2), var(--cream)); }
  .split__label { font-size: 1.6rem; font-weight: 500; color: var(--ink); opacity: 0.32; letter-spacing: -0.01em; }
  .split__panel--blush .split__label { color: var(--rose); opacity: 0.6; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } .split--reverse .split__panel { order: 0; } }

  /* Portal (dunkles Band) */
  .portal { display: flex; align-items: center; justify-content: space-between; gap: 2.5rem; flex-wrap: wrap; }
  .portal__lead { font-size: 1.1rem; color: rgba(255,255,255,0.78); max-width: 560px; margin: 0; }
  .portal .eyebrow { color: var(--rose-soft); }
  .portal__btn { flex-shrink: 0; }

  /* FAQ */
  .faq__item { border-bottom: 1px solid var(--line-strong); padding: 1.2rem 0.2rem; }
  .faq__item summary { font-weight: 500; font-size: 1.1rem; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; color: var(--ink); }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; color: var(--rose); font-size: 1.4rem; font-weight: 300; line-height: 1; }
  .faq__item[open] summary::after { content: '–'; }
  .faq__item p { margin: 0.9rem 0 0.2rem; color: var(--ink-soft); }
</style>
