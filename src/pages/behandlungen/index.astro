---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site, treatments } from '../../data/site.js';
import { u } from '../../lib/url.js';
---
<Base title="Behandlungen – Next Fertility Bregenz" description="Alle Kinderwunschbehandlungen auf einen Blick: IVF, ICSI, Eizellspende, Eizellvorsorge, Andrologie, Hysteroskopie, Genetik und mehr.">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Behandlungen</span>
        <h2>Unser gesamtes <em>Behandlungsspektrum</em></h2>
        <p class="lead">Übersichtlich gebündelt – jede Behandlung nach demselben klaren Schema erklärt: Was, für wen, Ablauf und Antworten auf häufige Fragen.</p>
      </div>
      <div class="grid grid-3">
        {treatments.map((t) => (
          <a href={u(`/behandlungen/${t.slug}/`)} class="card treatment">
            <span class="treatment__tag">{t.tag}{t.neu && <em class="treatment__neu">Neu</em>}</span>
            <h3>{t.title}</h3>
            <p>{t.teaser}</p>
            <span class="treatment__more">Mehr erfahren <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
      <div class="cta-band">
        <p>Nicht sicher, was zu Ihnen passt? Das klären wir gemeinsam im kostenlosen Kurzgespräch.</p>
        <a href={site.bookingKurzgespraech} class="btn btn--primary" target="_blank" rel="noopener">Kurzgespräch buchen</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .treatment { display: flex; flex-direction: column; }
  .treatment__tag { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.9rem; display: flex; align-items: center; gap: 0.6rem; }
  .treatment__neu { font-style: normal; color: var(--rose); border: 1px solid var(--rose-soft); padding: 0.05rem 0.45rem; border-radius: var(--radius-pill); font-size: 0.62rem; letter-spacing: 0.1em; }
  .treatment h3 { margin-bottom: 0.5rem; }
  .treatment p { font-size: 0.93rem; color: var(--muted); line-height: 1.6; flex-grow: 1; margin-bottom: 1rem; }
  .treatment__more { color: var(--rose); font-weight: 600; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 0.35rem; }
  .cta-band { margin-top: 3rem; background: var(--blush); border-radius: var(--radius-lg); padding: 1.8rem 2.2rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .cta-band p { margin: 0; font-size: 1.05rem; color: var(--ink-soft); }
</style>
