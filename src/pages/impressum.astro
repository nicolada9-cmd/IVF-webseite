---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
// Impressumsdaten übernommen von ivf.at (Stand des Entwurfs – vor Live-Gang prüfen).
---
<Base title="Impressum – Next Fertility IVF Prof. Zech Bregenz" description="Impressum und Offenlegung gemäß §5 ECG und §25 MedienG – Next Fertility IVF Prof. Zech Bregenz GmbH.">
  <section class="imp">
    <div class="container container--narrow">
      <span class="eyebrow">Rechtliches</span>
      <h1>Impressum</h1>
      <p class="lead">Offenlegung gemäß § 5 ECG und § 25 Mediengesetz.</p>

      <div class="imp__block">
        <h2>Medieninhaber &amp; Betreiber</h2>
        <p>
          <strong>Next Fertility IVF Prof. Zech Bregenz GmbH</strong><br />
          Römerstraße 2/IV<br />
          6900 Bregenz<br />
          Österreich
        </p>
      </div>

      <div class="imp__block">
        <h2>Kontakt</h2>
        <dl class="imp__dl">
          <div><dt>Telefon</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
          <div><dt>E-Mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>Web</dt><dd><a href="https://www.ivf.at" target="_blank" rel="noopener">www.ivf.at</a></dd></div>
        </dl>
      </div>

      <div class="imp__block">
        <h2>Geschäftsführung &amp; ärztliche Leitung</h2>
        <dl class="imp__dl">
          <div><dt>Ärztliche Leiterin</dt><dd>Dr. Adriane Damko</dd></div>
          <div><dt>Geschäftsführung</dt><dd>Dr. Adriane Damko, Marcus Cholewa</dd></div>
        </dl>
      </div>

      <div class="imp__block">
        <h2>Unternehmensregistrierung</h2>
        <dl class="imp__dl">
          <div><dt>UID-Nummer</dt><dd>ATU73533018</dd></div>
          <div><dt>Firmenbuchnummer</dt><dd>FN 495633 y</dd></div>
          <div><dt>Gerichtsstand</dt><dd>Landesgericht Feldkirch</dd></div>
          <div><dt>Anwendbares Recht</dt><dd>Österreichisches Recht</dd></div>
        </dl>
      </div>

      <div class="imp__block">
        <h2>Berufsrechtliche Regelung</h2>
        <p>
          Die Ärztinnen und Ärzte sind Mitglieder der Ärztekammer
          (<a href="https://www.aekvbg.or.at" target="_blank" rel="noopener">aekvbg.or.at</a>,
          <a href="https://www.aeksbg.at" target="_blank" rel="noopener">aeksbg.at</a>).
          Berufsrechtliche Regelung: Berufsordnung der Ärzte; die Tätigkeit unterliegt dem Ärztegesetz.
        </p>
      </div>

      <div class="imp__block">
        <h2>Website</h2>
        <p>Konzept, inhaltliche und grafische Umsetzung sowie Programmierung durch die Betreiberin.</p>
      </div>

      <p class="imp__hint">Hinweis: Dieser Entwurf übernimmt die Impressumsangaben von ivf.at. Vor dem Live-Gang bitte auf Aktualität und Vollständigkeit prüfen.</p>
    </div>
  </section>
</Base>

<style>
  .imp { padding-block: clamp(2.6rem, 5vw, 4rem) var(--space-section); }
  .imp h1 { margin-bottom: 0.4rem; }
  .imp .lead { margin-bottom: 2.6rem; }
  .imp__block { padding: 1.4rem 0; border-top: 1px solid var(--line); }
  .imp__block h2 { font-size: 1.15rem; margin-bottom: 0.7rem; }
  .imp__block p { color: var(--ink-soft); margin: 0; line-height: 1.7; }
  .imp__dl { margin: 0; display: grid; gap: 0.5rem; }
  .imp__dl > div { display: grid; grid-template-columns: 210px 1fr; gap: 1rem; }
  .imp__dl dt { color: var(--muted); font-size: 0.95rem; }
  .imp__dl dd { margin: 0; color: var(--ink); }
  .imp__dl a:hover { color: var(--rose); }
  .imp__hint { margin-top: 2.4rem; font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 560px) { .imp__dl > div { grid-template-columns: 1fr; gap: 0.15rem; } }
</style>
