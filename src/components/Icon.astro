---
// Feine, einfarbige Linien-Icons (stroke = currentColor).
const { name, class: cls = '' } = Astro.props;

const paths = {
  lock: '<rect x="4.5" y="9" width="11" height="8.5" rx="1.5"/><path d="M6.75 9V6.25a3.25 3.25 0 0 1 6.5 0V9"/>',
  phone: '<path d="M5 3.5h2.2l1.1 3-1.4 1a9 9 0 0 0 4.6 4.6l1-1.4 3 1.1V15a1.6 1.6 0 0 1-1.7 1.6A12.5 12.5 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z"/>',
  pin: '<path d="M10 17.5s5.2-4.6 5.2-8.4A5.2 5.2 0 0 0 4.8 9.1c0 3.8 5.2 8.4 5.2 8.4Z"/><circle cx="10" cy="8.9" r="1.9"/>',
  mail: '<rect x="3.5" y="5" width="13" height="10" rx="1.5"/><path d="m4 6 6 4.5L16 6"/>',
  arrow: '<path d="M4 10h12M11 5l5 5-5 5"/>',
  check: '<path d="M4.5 10.5 8 14l7.5-8"/>',
};
const body = paths[name] ?? '';
---
<svg class={`icon ${cls}`} viewBox="0 0 20 20" role="img" aria-hidden="true" set:html={body}></svg>
