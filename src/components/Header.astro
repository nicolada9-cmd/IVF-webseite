---
import { site, nav } from '../data/site.js';
import { u } from '../lib/url.js';
import Icon from './Icon.astro';
---
<header class="site-header">
  <div class="topbar">
    <div class="container topbar__inner">
      <a href={site.phoneHref} class="topbar__item"><Icon name="phone" /> {site.phone}</a>
      <span class="topbar__item topbar__item--muted topbar__addr"><Icon name="pin" /> {site.address}</span>
      <a href={site.patientenportal} class="topbar__portal" target="_blank" rel="noopener"><Icon name="lock" /> Patientenportal</a>
    </div>
  </div>

  <div class="container nav">
    <a href={u('/')} class="nav__logo" aria-label={`${site.brand} Startseite`}>
      <img src={u('/img/logo-placeholder.svg')} alt={`${site.brand} – Platzhalter-Logo`} width="230" height="40" />
    </a>

    <nav class="nav__menu" aria-label="Hauptnavigation">
      {nav.map((item) => (
        <a href={u(item.href)} class="nav__link">{item.label}</a>
      ))}
    </nav>

    <div class="nav__actions">
      <a href={site.bookingKurzgespraech} class="btn btn--text nav__cta-secondary" target="_blank" rel="noopener">Kurzgespräch</a>
      <a href={site.bookingErstgespraech} class="btn btn--primary" target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
    </div>

    <button class="nav__burger" aria-label="Menü öffnen" aria-expanded="false" id="burger">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    {nav.map((item) => <a href={u(item.href)} class="mobile-menu__link">{item.label}</a>)}
    <a href={site.patientenportal} class="mobile-menu__link" target="_blank" rel="noopener"><Icon name="lock" /> Patientenportal</a>
    <div class="mobile-menu__actions">
      <a href={site.bookingKurzgespraech} class="btn btn--secondary" target="_blank" rel="noopener">Kurzgespräch</a>
      <a href={site.bookingErstgespraech} class="btn btn--primary" target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .topbar { border-bottom: 1px solid var(--line); }
  .topbar__inner { display: flex; align-items: center; gap: 1.4rem; height: 40px; font-size: 0.8rem; color: var(--muted); }
  .topbar__item { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--ink-soft); }
  .topbar__item .icon { color: var(--rose); width: 0.95em; height: 0.95em; }
  .topbar__item--muted { color: var(--muted); }
  .topbar__portal { margin-left: auto; display: inline-flex; align-items: center; gap: 0.4rem; color: var(--rose); font-weight: 600; }
  .topbar__portal:hover { color: var(--rose-deep); }

  .nav { display: flex; align-items: center; gap: 1.4rem; height: 78px; }
  .nav__logo img { height: 38px; width: auto; }
  .nav__menu { display: flex; gap: 1.4rem; margin-left: 0.8rem; flex-wrap: nowrap; }
  .nav__link { font-weight: 400; font-size: 0.96rem; color: var(--ink-soft); padding: 0.4rem 0; position: relative; white-space: nowrap; }
  .nav__link::after { content: ''; position: absolute; left: 0; bottom: 0.1rem; width: 0; height: 1px; background: var(--rose); transition: width 0.25s ease; }
  .nav__link:hover { color: var(--rose); }
  .nav__link:hover::after { width: 100%; }
  .nav__actions { display: flex; gap: 1.1rem; margin-left: auto; align-items: center; flex-shrink: 0; }
  .nav__burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 8px; margin-left: auto; }
  .nav__burger span { width: 22px; height: 1.5px; background: var(--ink); border-radius: 2px; }

  .mobile-menu { display: flex; flex-direction: column; gap: 0.2rem; padding: 1rem 1.5rem 1.8rem; border-top: 1px solid var(--line); }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__link { padding: 0.8rem 0; border-bottom: 1px solid var(--line); font-weight: 400; color: var(--ink-soft); display: flex; align-items: center; gap: 0.45rem; }
  .mobile-menu__link .icon { color: var(--rose); }
  .mobile-menu__actions { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1.2rem; }
  .mobile-menu__actions .btn { width: 100%; justify-content: center; }

  @media (max-width: 1180px) {
    .nav__menu, .nav__actions { display: none; }
    .nav__burger { display: flex; }
    .topbar__addr { display: none; }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobileMenu');
  burger?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden');
    if (open) { menu?.removeAttribute('hidden'); } else { menu?.setAttribute('hidden', ''); }
    burger.setAttribute('aria-expanded', String(open));
  });
</script>
