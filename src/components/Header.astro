---
import { site, nav } from '../data/site.js';
import { u } from '../lib/url.js';
import Icon from './Icon.astro';
const { heroOverlay = false } = Astro.props;
---
<header class:list={['site-header', { 'header--overlay': heroOverlay }]} id="siteHeader">
  <div class="container nav">
    <a href={u('/')} class="logo" aria-label={`${site.brand} Startseite`}>
      <img src={u('/img/logo-mark.svg')} alt="" class="logo__mark" width="46" height="38" />
      <span class="logo__text">
        <span class="logo__name">Next Fertility</span>
        <span class="logo__sub">IVF Zech · Bregenz</span>
      </span>
    </a>

    <nav class="nav__menu" aria-label="Hauptnavigation">
      {nav.map((item) => (
        item.children ? (
          <div class="nav__item">
            {item.href
              ? <a href={u(item.href)} class="nav__link nav__link--top">{item.label} <Icon name="chevron" class="chev" /></a>
              : <span class="nav__link nav__link--top" tabindex="0" role="button" aria-haspopup="true">{item.label} <Icon name="chevron" class="chev" /></span>}
            <div class:list={['dropdown', { 'dropdown--mega': item.mega }]}>
              {item.mega ? (
                <div class="mega">
                  {item.children.map((c) => (
                    <a href={u(c.href)} class="mega__item">
                      <span class="mega__title">{c.label}{c.neu && <em class="mega__neu">Neu</em>}</span>
                      {c.teaser && <span class="mega__teaser">{c.teaser}</span>}
                    </a>
                  ))}
                </div>
              ) : (
                <div class="submenu">
                  {item.children.map((c) => (
                    <a href={c.external ? c.href : u(c.href)} class="submenu__item" {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>{c.label}</a>
                  ))}
                </div>
              )}
            </div>
          </div>
        ) : (
          <a href={u(item.href)} class="nav__link nav__link--top">{item.label}</a>
        )
      ))}
    </nav>

    <div class="nav__actions">
      <a href={site.patientenportal} class="nav__portal" target="_blank" rel="noopener"><Icon name="lock" /> Portal</a>
      <a href={site.bookingErstgespraech} class="btn btn--primary nav__cta" target="_blank" rel="noopener">Erstgespräch</a>
      <button class="nav__burger" aria-label="Menü öffnen" aria-expanded="false" id="burger">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    {nav.map((item) => (
      item.children ? (
        <details class="m-acc">
          <summary>{item.label}<Icon name="chevron" class="chev" /></summary>
          <div class="m-sub">
            {item.children.map((c) => (
              <a href={c.external ? c.href : u(c.href)} class="m-sub__link" {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>{c.label}{c.neu && <em class="mega__neu">Neu</em>}</a>
            ))}
          </div>
        </details>
      ) : (
        <a href={u(item.href)} class="mobile-menu__link">{item.label}</a>
      )
    ))}
    <a href={site.patientenportal} class="mobile-menu__link" target="_blank" rel="noopener"><Icon name="lock" /> Patientenportal</a>
    <div class="mobile-menu__actions">
      <a href={site.bookingKurzgespraech} class="btn btn--secondary" target="_blank" rel="noopener">Kurzgespräch</a>
      <a href={site.bookingErstgespraech} class="btn btn--primary" target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; height: var(--header-h); z-index: 100;
    display: flex; align-items: center;
    background: rgba(255,255,255,0.96); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, color 0.3s ease;
  }
  .nav { display: flex; align-items: center; gap: 1.5rem; width: 100%; }

  /* Logo */
  .logo { display: flex; flex-direction: row; align-items: center; gap: 0.6rem; flex-shrink: 0; }
  .logo__mark { height: 38px; width: auto; flex-shrink: 0; }
  .logo__text { display: flex; flex-direction: column; line-height: 1.05; white-space: nowrap; }
  .logo__name { font-family: var(--font-display); font-size: 1.4rem; font-weight: 500; color: var(--ink); white-space: nowrap; }
  .logo__sub { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-top: 2px; white-space: nowrap; }

  /* Menü – Großbuchstaben, gesperrt */
  .nav__menu { display: flex; align-items: center; gap: 1.4rem; margin-left: auto; }
  .nav__item { position: relative; }
  .nav__link--top {
    font-size: 0.74rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-soft); padding: 0.4rem 0; white-space: nowrap; cursor: pointer;
    display: inline-flex; align-items: center; gap: 0.3rem; position: relative; background: none; border: 0;
  }
  .nav__link--top .chev { width: 0.72em; height: 0.72em; opacity: 0.6; transition: transform 0.25s ease; }
  .nav__item:hover .chev, .nav__item:focus-within .chev { transform: rotate(180deg); }
  .nav__link--top::after { content: ''; position: absolute; left: 0; bottom: -0.1rem; width: 0; height: 1.5px; background: var(--rose); transition: width 0.25s ease; }
  .nav__link--top:hover, .nav__item:hover .nav__link--top, .nav__item:focus-within .nav__link--top { color: var(--rose); }
  .nav__item:hover .nav__link--top::after, .nav__link--top:hover::after { width: 100%; }

  /* Dropdown */
  .dropdown {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(8px);
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md); padding: 0.5rem; min-width: 250px;
    opacity: 0; visibility: hidden; transition: opacity 0.22s ease, transform 0.22s ease; z-index: 80;
  }
  .dropdown::before { content: ''; position: absolute; top: -12px; left: 0; right: 0; height: 12px; }
  .nav__item:hover .dropdown, .nav__item:focus-within .dropdown {
    opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0);
  }
  .dropdown--mega { left: 0; transform: translateX(0) translateY(8px); width: min(640px, 78vw); }
  .nav__item:hover .dropdown--mega, .nav__item:focus-within .dropdown--mega { transform: translateX(0) translateY(0); }

  .submenu { display: flex; flex-direction: column; }
  .submenu__item { padding: 0.62rem 0.9rem; border-radius: 8px; font-size: 0.92rem; color: var(--ink-soft); white-space: nowrap; }
  .submenu__item:hover { background: var(--blush); color: var(--rose-deep); }

  .mega { display: grid; grid-template-columns: 1fr 1fr; gap: 0.15rem; }
  .mega__item { padding: 0.7rem 0.9rem; border-radius: 8px; display: flex; flex-direction: column; gap: 0.15rem; }
  .mega__item:hover { background: var(--blush); }
  .mega__title { font-size: 0.94rem; font-weight: 500; color: var(--ink); display: flex; align-items: center; gap: 0.4rem; }
  .mega__item:hover .mega__title { color: var(--rose-deep); }
  .mega__teaser { font-size: 0.8rem; color: var(--muted); line-height: 1.4; }
  .mega__neu { font-style: normal; color: var(--rose); border: 1px solid var(--rose-soft); padding: 0 0.35rem; border-radius: var(--radius-pill); font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase; }

  .nav__actions { display: flex; align-items: center; gap: 1.3rem; margin-left: 1.5rem; }
  .nav__portal { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.74rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); }
  .nav__portal:hover { color: var(--rose); }
  .nav__portal .icon { color: var(--rose); }

  .nav__burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 6px; }
  .nav__burger span { width: 22px; height: 1.5px; background: var(--ink); border-radius: 2px; transition: background 0.3s ease; }

  /* Overlay-Zustand (transparent über dem Hero) */
  .header--overlay:not(.is-scrolled) {
    background: transparent; border-color: transparent;
    background-image: linear-gradient(180deg, rgba(20,15,18,0.35), rgba(20,15,18,0));
  }
  .header--overlay:not(.is-scrolled) .logo__name { color: #fff; }
  .header--overlay:not(.is-scrolled) .logo__sub { color: rgba(255,255,255,0.75); }
  .header--overlay:not(.is-scrolled) .nav__link--top { color: rgba(255,255,255,0.92); }
  .header--overlay:not(.is-scrolled) .nav__item:hover .nav__link--top,
  .header--overlay:not(.is-scrolled) .nav__link--top:hover { color: #fff; }
  .header--overlay:not(.is-scrolled) .nav__link--top::after { background: #fff; }
  .header--overlay:not(.is-scrolled) .nav__portal { color: rgba(255,255,255,0.92); }
  .header--overlay:not(.is-scrolled) .nav__portal .icon { color: #fff; }
  .header--overlay:not(.is-scrolled) .nav__burger span { background: #fff; }
  /* Dropdown-Inhalt bleibt immer hell/lesbar */
  .header--overlay .dropdown { color: var(--ink); }

  .site-header.is-scrolled { box-shadow: var(--shadow-sm); }

  /* Mobile-Menü */
  .mobile-menu { position: absolute; top: var(--header-h); left: 0; right: 0; max-height: calc(100vh - var(--header-h)); overflow-y: auto; background: #fff; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 0.1rem; padding: 1rem 1.6rem 1.8rem; box-shadow: var(--shadow-md); }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__link, .m-acc > summary { padding: 0.85rem 0; border-bottom: 1px solid var(--line); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); display: flex; align-items: center; gap: 0.5rem; cursor: pointer; list-style: none; justify-content: space-between; }
  .mobile-menu__link .icon { color: var(--rose); }
  .m-acc > summary::-webkit-details-marker { display: none; }
  .m-acc > summary .chev { width: 0.9em; height: 0.9em; opacity: 0.6; transition: transform 0.25s ease; }
  .m-acc[open] > summary .chev { transform: rotate(180deg); }
  .m-sub { display: flex; flex-direction: column; padding: 0.3rem 0 0.6rem 0.4rem; }
  .m-sub__link { padding: 0.6rem 0; font-size: 0.95rem; color: var(--ink-soft); display: flex; align-items: center; gap: 0.5rem; }
  .m-sub__link:hover { color: var(--rose); }
  .mobile-menu__actions { display: flex; flex-direction: column; gap: 0.7rem; margin-top: 1.2rem; }
  .mobile-menu__actions .btn { width: 100%; justify-content: center; }

  @media (max-width: 1180px) {
    .nav__menu, .nav__portal { display: none; }
    .nav__actions { margin-left: auto; }
    .nav__burger { display: flex; }
    .nav__cta { display: none; }
  }
</style>

<script>
  const header = document.getElementById('siteHeader');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobileMenu');
  burger?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden');
    if (open) { menu?.removeAttribute('hidden'); } else { menu?.setAttribute('hidden', ''); }
    burger.setAttribute('aria-expanded', String(open));
  });
</script>
