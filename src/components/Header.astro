---
import { site, nav } from '../data/site.js';
import { u } from '../lib/url.js';
import Icon from './Icon.astro';
const { heroOverlay = false } = Astro.props;
---
<header class:list={['site-header', { 'header--overlay': heroOverlay }]} id="siteHeader">
  <div class="container nav">
    <a href={u('/')} class="logo" aria-label={`${site.brand} Startseite`}>
      <img src={u('/img/logo-mark.svg')} alt="" class="logo__mark" width="46" height="38" />
      <span class="logo__text">
        <span class="logo__name">Next Fertility</span>
        <span class="logo__sub">IVF Zech · Bregenz</span>
      </span>
    </a>

    <nav class="nav__menu" aria-label="Hauptnavigation">
      {nav.map((item) => <a href={u(item.href)} class="nav__link">{item.label}</a>)}
    </nav>

    <div class="nav__actions">
      <a href={site.patientenportal} class="nav__portal" target="_blank" rel="noopener"><Icon name="lock" /> Portal</a>
      <a href={site.bookingErstgespraech} class="btn btn--primary nav__cta" target="_blank" rel="noopener">Erstgespräch</a>
      <button class="nav__burger" aria-label="Menü öffnen" aria-expanded="false" id="burger">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    {nav.map((item) => <a href={u(item.href)} class="mobile-menu__link">{item.label}</a>)}
    <a href={site.patientenportal} class="mobile-menu__link" target="_blank" rel="noopener"><Icon name="lock" /> Patientenportal</a>
    <div class="mobile-menu__actions">
      <a href={site.bookingKurzgespraech} class="btn btn--secondary" target="_blank" rel="noopener">Kurzgespräch</a>
      <a href={site.bookingErstgespraech} class="btn btn--primary" target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; height: var(--header-h); z-index: 100;
    display: flex; align-items: center;
    background: rgba(255,255,255,0.96); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, color 0.3s ease;
  }
  .nav { display: flex; align-items: center; gap: 1.5rem; width: 100%; }

  /* Logo: Bildmarke + Wortzeichen (Platzhalter) */
  .logo { display: flex; flex-direction: row; align-items: center; gap: 0.6rem; flex-shrink: 0; }
  .logo__mark { height: 38px; width: auto; flex-shrink: 0; }
  .logo__text { display: flex; flex-direction: column; line-height: 1.05; white-space: nowrap; }
  .logo__name { font-family: var(--font-display); font-size: 1.4rem; font-weight: 500; color: var(--ink); white-space: nowrap; }
  .logo__sub { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-top: 2px; white-space: nowrap; }

  /* Menü – Großbuchstaben, gesperrt */
  .nav__menu { display: flex; gap: 1.5rem; margin-left: auto; }
  .nav__link {
    font-size: 0.76rem; font-weight: 500; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--ink-soft); position: relative; padding: 0.4rem 0; white-space: nowrap;
  }
  .nav__link::after { content: ''; position: absolute; left: 0; bottom: 0; width: 0; height: 1.5px; background: var(--rose); transition: width 0.25s ease; }
  .nav__link:hover { color: var(--rose); }
  .nav__link:hover::after { width: 100%; }

  .nav__actions { display: flex; align-items: center; gap: 1.3rem; margin-left: 1.5rem; }
  .nav__portal { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.74rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); }
  .nav__portal:hover { color: var(--rose); }
  .nav__portal .icon { color: var(--rose); }

  .nav__burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 6px; }
  .nav__burger span { width: 22px; height: 1.5px; background: var(--ink); border-radius: 2px; transition: background 0.3s ease; }

  /* --- Overlay-Zustand (transparent über dem Hero) --------- */
  .header--overlay:not(.is-scrolled) {
    background: transparent; border-color: transparent;
    background-image: linear-gradient(180deg, rgba(20,15,18,0.35), rgba(20,15,18,0));
  }
  .header--overlay:not(.is-scrolled) .logo__name { color: #fff; }
  .header--overlay:not(.is-scrolled) .logo__sub { color: rgba(255,255,255,0.75); }
  .header--overlay:not(.is-scrolled) .nav__link { color: rgba(255,255,255,0.92); }
  .header--overlay:not(.is-scrolled) .nav__link:hover { color: #fff; }
  .header--overlay:not(.is-scrolled) .nav__link::after { background: #fff; }
  .header--overlay:not(.is-scrolled) .nav__portal { color: rgba(255,255,255,0.92); }
  .header--overlay:not(.is-scrolled) .nav__portal .icon { color: #fff; }
  .header--overlay:not(.is-scrolled) .nav__portal:hover { color: #fff; }
  .header--overlay:not(.is-scrolled) .nav__burger span { background: #fff; }

  .site-header.is-scrolled { box-shadow: var(--shadow-sm); }

  /* --- Mobile-Menü ----------------------------------------- */
  .mobile-menu { position: absolute; top: var(--header-h); left: 0; right: 0; background: #fff; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 0.1rem; padding: 1rem 1.6rem 1.8rem; box-shadow: var(--shadow-md); }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__link { padding: 0.85rem 0; border-bottom: 1px solid var(--line); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); display: flex; align-items: center; gap: 0.5rem; }
  .mobile-menu__link .icon { color: var(--rose); }
  .mobile-menu__actions { display: flex; flex-direction: column; gap: 0.7rem; margin-top: 1.2rem; }
  .mobile-menu__actions .btn { width: 100%; justify-content: center; }

  @media (max-width: 1080px) {
    .nav__menu, .nav__portal { display: none; }
    .nav__actions { margin-left: auto; }
    .nav__burger { display: flex; }
    .nav__cta { display: none; }
  }
</style>

<script>
  const header = document.getElementById('siteHeader');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobileMenu');
  burger?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden');
    if (open) { menu?.removeAttribute('hidden'); } else { menu?.setAttribute('hidden', ''); }
    burger.setAttribute('aria-expanded', String(open));
  });
</script>
