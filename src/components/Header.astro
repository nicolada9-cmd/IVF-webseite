---
import { site, nav } from '../data/site.js';
---
<header class="site-header">
  <div class="topbar">
    <div class="container topbar__inner">
      <a href={site.phoneHref} class="topbar__item">☎ {site.phone}</a>
      <span class="topbar__sep">·</span>
      <span class="topbar__item topbar__item--muted">{site.address}</span>
      <a href={site.patientenportal} class="topbar__portal" target="_blank" rel="noopener">
        🔒 Patientenportal
      </a>
    </div>
  </div>

  <div class="container nav">
    <a href="/" class="nav__logo" aria-label={`${site.brand} Startseite`}>
      <img src="/img/logo-placeholder.svg" alt={`${site.brand} – Platzhalter-Logo`} width="220" height="44" />
    </a>

    <nav class="nav__menu" aria-label="Hauptnavigation">
      {nav.map((item) => (
        <a href={item.href} class="nav__link">{item.label}</a>
      ))}
    </nav>

    <div class="nav__actions">
      <a href={site.bookingKurzgespraech} class="btn btn--secondary nav__cta-secondary" target="_blank" rel="noopener">Kurzgespräch</a>
      <a href={site.bookingErstgespraech} class="btn btn--primary" target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
    </div>

    <button class="nav__burger" aria-label="Menü öffnen" aria-expanded="false" id="burger">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    {nav.map((item) => <a href={item.href} class="mobile-menu__link">{item.label}</a>)}
    <a href={site.patientenportal} class="mobile-menu__link" target="_blank" rel="noopener">🔒 Patientenportal</a>
    <div class="mobile-menu__actions">
      <a href={site.bookingKurzgespraech} class="btn btn--secondary" target="_blank" rel="noopener">Kurzgespräch</a>
      <a href={site.bookingErstgespraech} class="btn btn--primary" target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .topbar { background: var(--rose-900); color: #fff; font-size: 0.82rem; }
  .topbar__inner { display: flex; align-items: center; gap: 0.7rem; height: 38px; }
  .topbar__item { color: #fff; opacity: 0.92; }
  .topbar__item--muted { opacity: 0.7; }
  .topbar__sep { opacity: 0.4; }
  .topbar__portal { margin-left: auto; font-weight: 600; color: #fff; padding: 0.25rem 0.7rem; border: 1px solid rgba(255,255,255,0.35); border-radius: var(--radius-pill); }
  .topbar__portal:hover { background: rgba(255,255,255,0.14); }

  .nav { display: flex; align-items: center; gap: 1.2rem; height: 76px; }
  .nav__logo img { height: 40px; width: auto; }
  .nav__menu { display: flex; gap: 1.05rem; margin-left: 0.6rem; flex-wrap: nowrap; }
  .nav__link { font-weight: 500; font-size: 0.93rem; color: var(--ink-700); padding: 0.4rem 0; border-bottom: 2px solid transparent; white-space: nowrap; }
  .nav__link:hover { color: var(--rose-700); border-color: var(--rose-400); }
  .nav__actions { display: flex; gap: 0.5rem; margin-left: auto; align-items: center; flex-shrink: 0; }
  .nav__burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 8px; margin-left: auto; }
  .nav__burger span { width: 24px; height: 2px; background: var(--ink-900); border-radius: 2px; }

  .mobile-menu { display: flex; flex-direction: column; gap: 0.2rem; padding: 1rem 1.4rem 1.6rem; border-top: 1px solid var(--line); }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__link { padding: 0.7rem 0; border-bottom: 1px solid var(--line); font-weight: 500; }
  .mobile-menu__actions { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1rem; }
  .mobile-menu__actions .btn { width: 100%; justify-content: center; }

  @media (max-width: 1200px) {
    .nav__menu, .nav__actions { display: none; }
    .nav__burger { display: flex; }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobileMenu');
  burger?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden');
    if (open) { menu?.removeAttribute('hidden'); } else { menu?.setAttribute('hidden', ''); }
    burger.setAttribute('aria-expanded', String(open));
  });
</script>
