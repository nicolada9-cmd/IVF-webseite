---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
const { eyebrow, title, lead, points = [] } = Astro.props;
---
<section class="ph-hero">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
  </div>
</section>
<section class="section">
  <div class="container ph-body">
    {points.length > 0 && (
      <ul class="ph-points">{points.map((p) => <li><Icon name="check" /> <span>{p}</span></li>)}</ul>
    )}
    <div class="ph-note">
      <strong>In Aufbau.</strong> Diese Seite wird im nächsten Schritt mit den extrahierten,
      strukturierten Inhalten der bestehenden Seiten gefüllt.
    </div>
    <div class="ph-cta">
      <a href={site.bookingErstgespraech} class="btn btn--primary" target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
      <a href={site.bookingKurzgespraech} class="btn btn--secondary" target="_blank" rel="noopener">Kostenloses Kurzgespräch</a>
    </div>
  </div>
</section>

<style>
  .ph-hero { background: linear-gradient(180deg, var(--blush), var(--bg) 80%); padding-block: 3rem; }
  .ph-hero .lead { max-width: 720px; }
  .ph-body { max-width: 820px; }
  .ph-points { list-style: none; padding: 0; margin: 0 0 2rem; }
  .ph-points li { display: flex; gap: 0.7rem; align-items: flex-start; margin-bottom: 0.7rem; font-size: 1.02rem; color: var(--ink-soft); }
  .ph-points li .icon { color: var(--rose); margin-top: 0.34em; flex-shrink: 0; }
  .ph-note { background: var(--bg-soft); border-left: 3px solid var(--rose-soft); border-radius: 10px; padding: 1rem 1.3rem; margin-bottom: 2rem; color: var(--ink-soft); }
  .ph-cta { display: flex; gap: 0.7rem; flex-wrap: wrap; }
</style>
