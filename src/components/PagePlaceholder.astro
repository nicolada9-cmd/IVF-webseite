---
import { site } from '../data/site.js';
const { eyebrow, title, lead, points = [] } = Astro.props;
---
<section class="ph-hero">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
  </div>
</section>
<section class="section">
  <div class="container ph-body">
    {points.length > 0 && (
      <ul class="ph-points">{points.map((p) => <li>{p}</li>)}</ul>
    )}
    <div class="ph-note">
      <strong>In Aufbau.</strong> Diese Seite wird im nächsten Schritt mit den extrahierten,
      strukturierten Inhalten der bestehenden Seiten gefüllt.
    </div>
    <div class="ph-cta">
      <a href={site.bookingErstgespraech} class="btn btn--primary" target="_blank" rel="noopener">Erstgespräch vereinbaren</a>
      <a href={site.bookingKurzgespraech} class="btn btn--secondary" target="_blank" rel="noopener">Kostenloses Kurzgespräch</a>
    </div>
  </div>
</section>

<style>
  .ph-hero { background: linear-gradient(160deg, var(--rose-100), var(--bg) 70%); padding-block: 2.8rem; }
  .ph-hero .lead { max-width: 720px; }
  .ph-body { max-width: 820px; }
  .ph-points { list-style: none; padding: 0; margin: 0 0 2rem; }
  .ph-points li { padding-left: 1.8rem; position: relative; margin-bottom: 0.7rem; font-size: 1.05rem; }
  .ph-points li::before { content: '→'; position: absolute; left: 0; color: var(--rose-600); font-weight: 700; }
  .ph-note { background: var(--blue-100); border-left: 4px solid var(--blue-500); border-radius: 10px; padding: 1rem 1.3rem; margin-bottom: 2rem; }
  .ph-cta { display: flex; gap: 0.7rem; flex-wrap: wrap; }
</style>
