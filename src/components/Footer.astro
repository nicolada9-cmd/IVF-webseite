---
import { site, nav, treatments } from '../data/site.js';
import { u } from '../lib/url.js';
import Icon from './Icon.astro';
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <div class="footer__logo">
        <img src={u('/img/logo-mark.svg')} alt="" class="footer__mark" width="46" height="38" />
        <span class="footer__logoText">
          <span class="footer__logoName">Next Fertility</span>
          <span class="footer__logoSub">IVF Zech · Bregenz</span>
        </span>
      </div>
      <p class="footer__addr"><Icon name="pin" /> {site.address}</p>
      <p class="footer__addr"><a href={site.phoneHref}><Icon name="phone" /> {site.phone}</a></p>
      <p class="footer__addr"><a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></p>
      <a href={site.patientenportal} class="footer__portal" target="_blank" rel="noopener"><Icon name="lock" /> Patientenportal</a>
    </div>

    <div class="footer__col">
      <h4>Behandlungen</h4>
      <ul>
        {treatments.slice(0, 6).map((t) => <li><a href={u(`/behandlungen/${t.slug}/`)}>{t.title}</a></li>)}
        <li><a href={u('/behandlungen/')} class="footer__more">Alle Behandlungen</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4>Orientierung</h4>
      <ul>{nav.map((n) => <li><a href={u(n.href)}>{n.label}</a></li>)}</ul>
    </div>

    <div class="footer__col">
      <h4>Termin</h4>
      <ul>
        <li><a href={site.bookingErstgespraech} target="_blank" rel="noopener">Erstgespräch vereinbaren</a></li>
        <li><a href={site.bookingKurzgespraech} target="_blank" rel="noopener">Kurzgespräch</a></li>
        <li><a href={u('/kontakt/')}>Kontakt</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {new Date().getFullYear()} {site.brand} · {site.brandSub} <span class="footer__ph">· Platzhalter-Branding</span></p>
    <nav class="footer__legal" aria-label="Rechtliches">
      <a href={u('/impressum/')}>Impressum</a>
      <a href={u('/datenschutz/')}>Datenschutz</a>
    </nav>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: #c6bfca; padding-top: 4rem; }
  .footer a { color: #c6bfca; transition: color 0.2s ease; }
  .footer a:hover { color: #fff; }
  .footer__grid { display: grid; grid-template-columns: 1.7fr 1fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; }
  .footer__logo { display: flex; flex-direction: row; align-items: center; gap: 0.6rem; margin-bottom: 1.3rem; }
  .footer__mark { height: 38px; width: auto; flex-shrink: 0; }
  .footer__logoText { display: flex; flex-direction: column; line-height: 1.05; }
  .footer__logoName { font-size: 1.4rem; font-weight: 500; color: #fff; }
  .footer__logoSub { font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--rose-soft); margin-top: 3px; }
  .footer__addr { font-size: 0.9rem; color: #a79fad; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.45rem; }
  .footer__addr .icon { color: var(--rose-soft); }
  .footer__portal { display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 0.9rem; font-weight: 500; color: #fff; border: 1px solid rgba(255,255,255,0.22); border-radius: var(--radius-pill); padding: 0.5rem 1rem; }
  .footer__portal:hover { border-color: var(--rose-soft); }
  .footer__portal .icon { color: var(--rose-soft); }
  .footer__col h4 { color: #fff; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 1rem; }
  .footer__col ul { list-style: none; margin: 0; padding: 0; }
  .footer__col li { margin-bottom: 0.55rem; font-size: 0.91rem; }
  .footer__more { color: var(--rose-soft) !important; }
  .footer__bottom { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; border-top: 1px solid rgba(255,255,255,0.1); padding-block: 1.5rem; font-size: 0.82rem; color: #8f8895; }
  .footer__ph { color: var(--rose-soft); }
  .footer__legal { display: flex; gap: 1.4rem; }
  @media (max-width: 860px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
