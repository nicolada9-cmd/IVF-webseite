---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import { u } from '../lib/url.js';

const {
  title = 'Next Fertility – Kinderwunschklinik Bregenz',
  description = 'Kinderwunschbehandlung in Bregenz: IVF, ICSI, Eizellspende, Eizellvorsorge und mehr. Persönlich begleitet – vom kostenlosen Kurzgespräch bis zur Behandlung.',
  jsonld = null,
  heroOverlay = false, // true = transparenter Header über Vollbild-Hero (Startseite)
} = Astro.props;

// Markenschrift Rotunda – selbst gehostet, base-aware eingebunden.
const rotundaFaces = `
@font-face{font-family:'Rotunda';src:url('${u('/fonts/rotunda/Rotunda-Light.woff2')}') format('woff2');font-weight:300;font-style:normal;font-display:swap;}
@font-face{font-family:'Rotunda';src:url('${u('/fonts/rotunda/Rotunda-Regular.woff2')}') format('woff2');font-weight:400;font-style:normal;font-display:swap;}
@font-face{font-family:'Rotunda';src:url('${u('/fonts/rotunda/Rotunda-Medium.woff2')}') format('woff2');font-weight:500;font-style:normal;font-display:swap;}
`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={u('/img/logo-placeholder.svg')} />
    <!-- Markenschrift Rotunda (selbst gehostet) -->
    <link rel="preload" href={u('/fonts/rotunda/Rotunda-Regular.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={u('/fonts/rotunda/Rotunda-Medium.woff2')} as="font" type="font/woff2" crossorigin />
    <style set:html={rotundaFaces}></style>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a href="#main" class="visually-hidden">Zum Inhalt springen</a>
    <Header heroOverlay={heroOverlay} />
    <main id="main" class={heroOverlay ? '' : 'main--offset'}>
      <slot />
    </main>
    <Footer />
    <style is:global>
      .main--offset { padding-top: var(--header-h); }
    </style>
  </body>
</html>
