---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import { u } from '../lib/url.js';

const {
  title = 'Next Fertility – Kinderwunschklinik Bregenz',
  description = 'Kinderwunschbehandlung in Bregenz: IVF, ICSI, Eizellspende, Eizellvorsorge und mehr. Persönlich begleitet – vom kostenlosen Kurzgespräch bis zur Behandlung.',
  jsonld = null,
} = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={u('/img/logo-placeholder.svg')} />
    <!-- Schriften: Fraunces (Display) + Inter (Text) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a href="#main" class="visually-hidden">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
